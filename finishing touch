    };

    float mx[3] = {
        b.x2,b.y2,b.z2
    };

    for(int i=0;i<3;i++)
    {
        if(fabsf(d[i])<0.00001f)
        {
            if(
                o[i]<mn[i] ||
                o[i]>mx[i]
            )
                return false;
        }
        else
        {
            float a =
                (mn[i]-o[i])/d[i];

            float c =
                (mx[i]-o[i])/d[i];

            if(a>c)
            {
                float q=a;
                a=c;
                c=q;
            }

            if(a>tmin)
                tmin=a;

            if(c<tmax)
                tmax=c;

            if(tmin>tmax)
                return false;
        }
    }

    t=tmin;

    return
        t>=0.0f &&
        t<=100.0f;
}

bool findInteractiveTarget(
    int &type,
    int &index
)
{
    float rad =
        3.14159265f/180.0f;

    float yr =
        yaw*rad;

    float pr =
        pitch*rad;

    float dx =
        cosf(pr)*sinf(yr);

    float dy =
        sinf(pr);

    float dz =
        cosf(pr)*cosf(yr);

    float bestT =
        100000.0f;

    type=-1;
    index=-1;

    const float bx[2] =
    {
        -3.2f,
        3.2f
    };

    const float bz[2] =
    {
        -3.4f,
        -3.4f
    };

    for(int i=0;i<2;i++)
    {
        ClickTarget b =
        {
            bx[i]-0.85f,
            1.15f,
            bz[i]-0.65f,

            bx[i]+0.85f,
            2.25f,
            bz[i]+0.65f
        };

        float t;

        if(
            rayBoxHit(
                camX,camY,camZ,
                dx,dy,dz,
                b,t
            ) &&
            t<bestT
        )
        {
            bestT=t;
            type=1;
            index=i;
        }
    }

    const float cx[4] =
    {
        -5.7f,
        5.7f,
        -7.0f,
        7.0f
    };

    const float cz[4] =
    {
        4.85f,
        4.85f,
        1.5f,
        1.5f
    };

    for(int i=0;i<4;i++)
    {
        ClickTarget b =
        {
            cx[i]-0.58f,
            1.07f,
            cz[i]-0.18f,

            cx[i]+0.58f,
            1.83f,
            cz[i]+0.18f
        };

        float t;

        if(
            rayBoxHit(
                camX,camY,camZ,
                dx,dy,dz,
                b,t
            ) &&
            t<bestT
        )
        {
            bestT=t;
            type=2;
            index=i;
        }
    }

    return type!=-1;
}

void handleMouseClick(
    int button,
    int state,
    int x,
    int y
)
{
    // Mouse wheel (freeglut buttons 3/4) = scale the exhibit
    if(state==GLUT_DOWN && button==3)
    {
        exScale *= 1.08f;
        if(exScale > 2.2f) exScale = 2.2f;
        return;
    }

    if(state==GLUT_DOWN && button==4)
    {
        exScale /= 1.08f;
        if(exScale < 0.4f) exScale = 0.4f;
        return;
    }

    if(
        button!=GLUT_LEFT_BUTTON ||
        state!=GLUT_DOWN
    )
        return;

    int type,index;

    if(
        !findInteractiveTarget(
            type,index
        )
    )
        return;

    if(type==1)
    {
        magicBookActive[index] =
            !magicBookActive[index];

        magicBookOpen =
            magicBookActive[0] ||
            magicBookActive[1];
    }
    else if(type==2)
    {
        computerOn[index] =
            !computerOn[index];
    }

    glutPostRedisplay();
}


