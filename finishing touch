// ============================================================
// OUTSIDE WORLD SEEN THROUGH THE WINDOW
// A small layered diorama (sky, sun, drifting clouds, birds,
// mountains, hills, trees) drawn inside the window opening and
// clipped to it with clip planes.  Farthest layer first.
// ============================================================
static void oDisc(float cx,float cy,float rx,float ry,float z)
{
    const int seg = 28;
    glBegin(GL_TRIANGLE_FAN);
    glVertex3f(cx,cy,z);
    for(int i=0;i<=seg;i++)
    {
        float a = 6.2831853f*i/seg;
        glVertex3f(cx+rx*cosf(a), cy+ry*sinf(a), z);
    }
    glEnd();
}

static float hillFar(float u)  { return -0.35f + 0.16f*sinf(1.7f*u + 0.5f); }
static float hillNear(float u) { return -0.78f + 0.13f*sinf(2.3f*u + 2.0f); }

static void oHill(float (*fn)(float), float z, float r,float g,float b)
{
    glColor3f(r,g,b);
    glBegin(GL_TRIANGLE_STRIP);
    for(float u=-1.6f; u<=1.61f; u+=0.1f)
    {
        glVertex3f(u, fn(u), z);
        glVertex3f(u, -1.6f, z);
    }
    glEnd();
}

static void oTree(float u,float sc)
{
    float base = hillNear(u);

    glColor3f(0.35f,0.20f,0.08f);
    glBegin(GL_QUADS);
    glVertex3f(u-0.03f*sc, base-0.03f,       0.0340f);
    glVertex3f(u+0.03f*sc, base-0.03f,       0.0340f);
    glVertex3f(u+0.03f*sc, base+0.20f*sc,    0.0340f);
    glVertex3f(u-0.03f*sc, base+0.20f*sc,    0.0340f);
    glEnd();

    glColor3f(0.08f,0.42f,0.14f);
    glBegin(GL_TRIANGLES);
    glVertex3f(u-0.16f*sc, base+0.15f*sc, 0.0335f);
    glVertex3f(u+0.16f*sc, base+0.15f*sc, 0.0335f);
    glVertex3f(u,          base+0.45f*sc, 0.0335f);
    glEnd();

    glColor3f(0.11f,0.52f,0.17f);
    glBegin(GL_TRIANGLES);
    glVertex3f(u-0.13f*sc, base+0.32f*sc, 0.0330f);
    glVertex3f(u+0.13f*sc, base+0.32f*sc, 0.0330f);
    glVertex3f(u,          base+0.62f*sc, 0.0330f);
    glEnd();
}

void outdoorView(float x,float y,float zGlass)
{
    const float HW = 1.39f;   // half width  of window opening
    const float HH = 1.44f;   // half height of window opening

    glPushAttrib(
        GL_ENABLE_BIT |
        GL_CURRENT_BIT |
        GL_LIGHTING_BIT |
        GL_DEPTH_BUFFER_BIT |
        GL_COLOR_BUFFER_BIT |
        GL_LINE_BIT |
        GL_TRANSFORM_BIT
    );

    glDisable(GL_LIGHTING);      // daylight: self-lit
    glDisable(GL_TEXTURE_2D);
    glDepthFunc(GL_LEQUAL);

    glPushMatrix();
    glTranslatef(x,y,zGlass);

    // clip everything to the window opening
    const GLdouble cpL[4] = { 1.0, 0.0,0.0, HW};
    const GLdouble cpR[4] = {-1.0, 0.0,0.0, HW};
    const GLdouble cpB[4] = { 0.0, 1.0,0.0, HH};
    const GLdouble cpT[4] = { 0.0,-1.0,0.0, HH};
    glClipPlane(GL_CLIP_PLANE0,cpL);
    glClipPlane(GL_CLIP_PLANE1,cpR);
    glClipPlane(GL_CLIP_PLANE2,cpB);
    glClipPlane(GL_CLIP_PLANE3,cpT);
    glEnable(GL_CLIP_PLANE0);
    glEnable(GL_CLIP_PLANE1);
    glEnable(GL_CLIP_PLANE2);
    glEnable(GL_CLIP_PLANE3);

    // ---- sky gradient (farthest) ----
    glBegin(GL_QUADS);
    glColor3f(0.78f,0.90f,1.00f); glVertex3f(-1.6f,-1.6f,0.078f);
    glColor3f(0.78f,0.90f,1.00f); glVertex3f( 1.6f,-1.6f,0.078f);
    glColor3f(0.20f,0.52f,0.95f); glVertex3f( 1.6f, 1.6f,0.078f);
    glColor3f(0.20f,0.52f,0.95f); glVertex3f(-1.6f, 1.6f,0.078f);
    glEnd();

    // ---- sun with soft halo ----
    float sunX = 0.62f;
    float sunY = 0.80f + 0.03f*sinf(skyTime*0.3f);

    glEnable(GL_BLEND);
    glBlendFunc(GL_SRC_ALPHA,GL_ONE_MINUS_SRC_ALPHA);
    glColor4f(1.0f,0.95f,0.60f,0.25f); oDisc(sunX,sunY,0.50f,0.50f,0.0740f);
    glColor4f(1.0f,0.95f,0.60f,0.35f); oDisc(sunX,sunY,0.34f,0.34f,0.0735f);
    glDisable(GL_BLEND);
    glColor3f(1.0f,0.97f,0.80f);       oDisc(sunX,sunY,0.20f,0.20f,0.0720f);

    // ---- drifting clouds ----
    const float cloudY[3] = {1.02f,0.66f,0.90f};
    glColor3f(1.0f,1.0f,1.0f);
    for(int i=0;i<3;i++)
    {
        float cx = fmodf(skyTime*(0.05f+0.02f*i) + i*1.3f, 3.6f) - 1.8f;
        float cy = cloudY[i];

        oDisc(cx,       cy,        0.24f,0.12f,0.0660f);
        oDisc(cx+0.18f, cy+0.06f,  0.20f,0.13f,0.0660f);
        oDisc(cx-0.20f, cy+0.03f,  0.18f,0.10f,0.0660f);
        oDisc(cx+0.02f, cy+0.10f,  0.16f,0.12f,0.0660f);
    }

    // ---- two birds ----
    glLineWidth(2.0f);
    glColor3f(0.12f,0.12f,0.15f);
    glBegin(GL_LINES);
    for(int b=0;b<2;b++)
    {
        float bx = fmodf(skyTime*0.12f + b*0.9f + 0.5f, 3.4f) - 1.7f;
        float by = 0.62f + 0.05f*sinf(skyTime*1.3f + b*2.0f) - 0.12f*b;
        float wy = 0.05f*sinf(skyTime*8.0f + b);

        glVertex3f(bx-0.07f, by+0.04f+wy, 0.0640f); glVertex3f(bx,       by, 0.0640f);
        glVertex3f(bx,       by,          0.0640f); glVertex3f(bx+0.07f, by+0.04f+wy, 0.0640f);
    }
    glEnd();
    glLineWidth(1.0f);

    // ---- distant mountains with snow caps ----
    glColor3f(0.45f,0.52f,0.66f);
    glBegin(GL_TRIANGLES);
    glVertex3f(-1.70f,-0.60f,0.058f); glVertex3f(-0.30f,-0.60f,0.058f); glVertex3f(-0.95f, 0.42f,0.058f);
    glVertex3f(-0.60f,-0.60f,0.058f); glVertex3f( 1.30f,-0.60f,0.058f); glVertex3f( 0.30f, 0.30f,0.058f);
    glVertex3f( 0.60f,-0.60f,0.058f); glVertex3f( 2.00f,-0.60f,0.058f); glVertex3f( 1.25f, 0.50f,0.058f);
    glEnd();

    glColor3f(0.95f,0.97f,1.00f);
    glBegin(GL_TRIANGLES);
    glVertex3f(-1.13f, 0.20f,0.0575f); glVertex3f(-0.77f, 0.20f,0.0575f); glVertex3f(-0.95f, 0.42f,0.0575f);
    glVertex3f( 1.05f, 0.29f,0.0575f); glVertex3f( 1.45f, 0.29f,0.0575f); glVertex3f( 1.25f, 0.50f,0.0575f);
    glEnd();

    // ---- rolling hills ----
    oHill(hillFar , 0.050f, 0.36f,0.63f,0.30f);
    oHill(hillNear, 0.042f, 0.22f,0.50f,0.20f);

    // ---- trees ----
    oTree(-1.05f,1.00f);
    oTree(-0.40f,0.80f);
    oTree( 0.50f,1.10f);
    oTree( 1.05f,0.85f);

    glPopMatrix();

    glDisable(GL_CLIP_PLANE0);
    glDisable(GL_CLIP_PLANE1);
    glDisable(GL_CLIP_PLANE2);
    glDisable(GL_CLIP_PLANE3);

    // ---- transparent glass pane in front (drawn last) ----
    glPushMatrix();
    glTranslatef(x,y,zGlass);

    glEnable(GL_BLEND);
    glBlendFunc(GL_SRC_ALPHA,GL_ONE_MINUS_SRC_ALPHA);
    glDepthMask(GL_FALSE);

    glColor4f(0.75f,0.88f,1.00f,0.10f);
    glBegin(GL_QUADS);
    glVertex3f(-HW,-HH,0.0f); glVertex3f( HW,-HH,0.0f);
    glVertex3f( HW, HH,0.0f); glVertex3f(-HW, HH,0.0f);
    glEnd();

    glColor4f(1.0f,1.0f,1.0f,0.14f);      // diagonal glass reflection
    glBegin(GL_QUADS);
    glVertex3f(-0.95f,-HH,-0.001f); glVertex3f(-0.55f,-HH,-0.001f);
    glVertex3f( 0.35f, HH,-0.001f); glVertex3f(-0.05f, HH,-0.001f);
    glEnd();

    glDepthMask(GL_TRUE);
    glPopMatrix();

    glPopAttrib();
}

