// ============================================================
// MODIFIED BOOKSHELF
// Books are now tightly packed and fill every shelf.
// ============================================================

void bookshelf(
    float x,float y,float z,
    float w,float h,float d
)
{
    float backZ  = z - d/2.0f + 0.04f;
    float frontZ = z + d/2.0f;

    // Wooden back panel
    texturedCube(
        x,
        y+h/2,
        backZ,
        w,
        h,
        0.18f,
        texWood,
        3.0f,
        3.0f
    );

    // Left wooden side panel
    texturedCube(
        x-w/2+0.10f,
        y+h/2,
        frontZ,
        0.20f,
        h+0.12f,
        d+0.10f,
        texWood,
        1.0f,
        3.0f
    );

    // Right wooden side panel
    texturedCube(
        x+w/2-0.10f,
        y+h/2,
        frontZ,
        0.20f,
        h+0.12f,
        d+0.10f,
        texWood,
        1.0f,
        3.0f
    );

    // Top wooden frame
    texturedCube(
        x,
        y+h-0.08f,
        frontZ,
        w+0.12f,
        0.18f,
        d+0.10f,
        texWood,
        4.0f,
        1.0f
    );

    // Bottom wooden frame
    texturedCube(
        x,
        y+0.08f,
        frontZ,
        w+0.12f,
        0.18f,
        d+0.10f,
        texWood,
        4.0f,
        1.0f
    );

    // Six shelves
    const int rows = 6;

    float usableH = h - 0.42f;
    float rowH = usableH / rows;

    for(int r=0; r<rows; r++)
    {
        float shelfY =
            y + 0.30f + r*rowH;

        // Shelf board
        texturedCube(
            x,
            shelfY,
            frontZ,
            w-0.16f,
            0.13f,
            d+0.02f,
            texWood,
            4.0f,
            1.0f
        );

        // ----------------------------------------------------
        // BOOKS
        // ----------------------------------------------------

        float leftLimit =
            x - w/2.0f + 0.17f;

        float rightLimit =
            x + w/2.0f - 0.17f;

        float px = leftLimit;

        float bookBase =
            shelfY + 0.07f;

        int bookIndex = 0;

        // Books are packed very tightly.
        while(px < rightLimit - 0.005f)
        {
            // Different book widths.
            float bw;

            switch((bookIndex + r) % 6)
            {
                case 0:
                    bw = 0.105f;
                    break;

                case 1:
                    bw = 0.125f;
                    break;

                case 2:
                    bw = 0.145f;
                    break;

                case 3:
                    bw = 0.115f;
                    break;

                case 4:
                    bw = 0.135f;
                    break;

                default:
                    bw = 0.155f;
                    break;
            }

            // Slightly different book heights.
            float variation =
                ((bookIndex*5 + r*3) % 7 - 3) * 0.025f;

            float bh =
                rowH * 0.80f + variation;

            // Keep every book safely inside the shelf.
            float maxBookHeight =
                rowH - 0.16f;

            if(bh > maxBookHeight)
                bh = maxBookHeight;

            if(bh < rowH*0.70f)
                bh = rowH*0.70f;

            // Prevent final book from going outside shelf.
            if(px + bw > rightLimit)
                bw = rightLimit - px;

            if(bw < 0.025f)
                break;

            // Many different colors.
            int colorIndex =
                (bookIndex*7 + r*4) % 12;

            // Books stay upright and close together.
            book(
                px + bw/2.0f,
                bookBase + bh/2.0f,
                frontZ + 0.09f,
                bw,
                bh,
                d*0.60f,
                colorIndex
            );

            // Very small gap between books.
            px += bw + 0.004f;

            bookIndex++;

            // Safety limit.
            if(bookIndex >= 180)
                break;
        }
    }

    // Thick bottom wooden plinth
    texturedCube(
        x,
        y-0.02f,
        frontZ,
        w+0.16f,
        0.28f,
        d+0.12f,
        texWood,
        4.0f,
        1.0f
    );
}


