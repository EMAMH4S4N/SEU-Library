void makeProceduralTexture(GLuint &tex, int type)
{
    const int W = 256, H = 256;
    unsigned char *data = new unsigned char[W * H * 3];

    for(int y=0; y<H; ++y)
    {
        for(int x=0; x<W; ++x)
        {
            float fx = (float)x / (float)W;
            float fy = (float)y / (float)H;

            float r=0.8f, g=0.8f, b=0.8f;

            if(type == 0)
            {
                float grain = 0.5f + 0.5f*sinf(fx*34.0f + sinf(fy*12.0f)*0.8f);
                float fine  = 0.5f + 0.5f*sinf(fx*190.0f + fy*9.0f);

                r = 0.24f + 0.34f*grain + 0.035f*fine;
                g = 0.07f + 0.15f*grain + 0.018f*fine;
                b = 0.018f + 0.060f*grain;
            }
            else if(type == 1)
            {
                int tx = x / 32;
                int ty = y / 32;

                bool edge = (x % 32 < 3) || (y % 32 < 3);

                float shade = ((tx+ty)%2) ? 0.78f : 0.88f;

                if(edge)
                    shade = 0.55f;

                r = g = b = shade;
            }
            else if(type == 2)
            {
                float noise = 0.96f + 0.04f*sinf(fx*55.0f)*sinf(fy*43.0f);

                r = 0.78f*noise;
                g = 0.75f*noise;
                b = 0.70f*noise;
            }
            else
            {
                // Decorative architectural wall tile: large rectangular
                // stone tiles with subtle marbling and thin warm-gold
                // grout lines, in a deep elegant palette that fits a
                // dark-fantasy / historical library.
                int tilePxX = x % 64;
                int tilePxY = y % 64;

                bool grout = (tilePxX < 2) || (tilePxY < 2);

                float marble = 0.5f + 0.5f*sinf(fx*23.0f + sinf(fy*17.0f)*1.4f);
                float fine   = 0.5f + 0.5f*sinf(fx*80.0f)*sinf(fy*80.0f);

                if(grout)
                {
                    r = 0.60f + 0.10f*fine;
                    g = 0.48f + 0.08f*fine;
                    b = 0.20f + 0.05f*fine;
                }
                else
                {
                    r = 0.17f + 0.07f*marble + 0.015f*fine;
                    g = 0.05f + 0.02f*marble + 0.010f*fine;
                    b = 0.07f + 0.03f*marble + 0.010f*fine;
                }
            }

            int i = (y*W+x)*3;

            data[i+0] = (unsigned char)(255.0f*fminf(fmaxf(r,0.0f),1.0f));
            data[i+1] = (unsigned char)(255.0f*fminf(fmaxf(g,0.0f),1.0f));
            data[i+2] = (unsigned char)(255.0f*fminf(fmaxf(b,0.0f),1.0f));
        }
    }

    glGenTextures(1, &tex);
    glBindTexture(GL_TEXTURE_2D, tex);

    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_REPEAT);
    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_REPEAT);

    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR_MIPMAP_LINEAR);
    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);

    gluBuild2DMipmaps(
        GL_TEXTURE_2D,
        GL_RGB,
        W,
        H,
        GL_RGB,
        GL_UNSIGNED_BYTE,
        data
    );

    glBindTexture(GL_TEXTURE_2D, 0);

    delete [] data;
}

void texturedCube(
    float x,float y,float z,
    float sx,float sy,float sz,
    GLuint tex,
    float repeatX=1.0f,
    float repeatY=1.0f
)
{
    glPushMatrix();

    glTranslatef(x,y,z);
    glScalef(sx,sy,sz);

    glEnable(GL_TEXTURE_2D);
    glBindTexture(GL_TEXTURE_2D, tex);

    glColor3f(1.0f,1.0f,1.0f);

    glBegin(GL_QUADS);

    glNormal3f(0,0,1);

    glTexCoord2f(0,0);
    glVertex3f(-0.5f,-0.5f,0.5f);

    glTexCoord2f(repeatX,0);
    glVertex3f(0.5f,-0.5f,0.5f);

    glTexCoord2f(repeatX,repeatY);
    glVertex3f(0.5f,0.5f,0.5f);

    glTexCoord2f(0,repeatY);
    glVertex3f(-0.5f,0.5f,0.5f);


    glNormal3f(0,0,-1);

    glTexCoord2f(0,0);
    glVertex3f(0.5f,-0.5f,-0.5f);

    glTexCoord2f(repeatX,0);
    glVertex3f(-0.5f,-0.5f,-0.5f);

    glTexCoord2f(repeatX,repeatY);
    glVertex3f(-0.5f,0.5f,-0.5f);

    glTexCoord2f(0,repeatY);
    glVertex3f(0.5f,0.5f,-0.5f);


    glNormal3f(-1,0,0);

    glTexCoord2f(0,0);
    glVertex3f(-0.5f,-0.5f,-0.5f);

    glTexCoord2f(repeatX,0);
    glVertex3f(-0.5f,-0.5f,0.5f);

    glTexCoord2f(repeatX,repeatY);
    glVertex3f(-0.5f,0.5f,0.5f);

    glTexCoord2f(0,repeatY);
    glVertex3f(-0.5f,0.5f,-0.5f);


    glNormal3f(1,0,0);

    glTexCoord2f(0,0);
    glVertex3f(0.5f,-0.5f,0.5f);

    glTexCoord2f(repeatX,0);
    glVertex3f(0.5f,-0.5f,-0.5f);

    glTexCoord2f(repeatX,repeatY);
    glVertex3f(0.5f,0.5f,-0.5f);

    glTexCoord2f(0,repeatY);
    glVertex3f(0.5f,0.5f,0.5f);


    glNormal3f(0,1,0);

    glTexCoord2f(0,0);
    glVertex3f(-0.5f,0.5f,0.5f);

    glTexCoord2f(repeatX,0);
    glVertex3f(0.5f,0.5f,0.5f);

    glTexCoord2f(repeatX,repeatY);
    glVertex3f(0.5f,0.5f,-0.5f);

    glTexCoord2f(0,repeatY);
    glVertex3f(-0.5f,0.5f,-0.5f);


    glNormal3f(0,-1,0);

    glTexCoord2f(0,0);
    glVertex3f(-0.5f,-0.5f,-0.5f);

    glTexCoord2f(repeatX,0);
    glVertex3f(0.5f,-0.5f,-0.5f);

    glTexCoord2f(repeatX,repeatY);
    glVertex3f(0.5f,-0.5f,0.5f);

    glTexCoord2f(0,repeatY);
    glVertex3f(-0.5f,-0.5f,0.5f);

    glEnd();

    glBindTexture(GL_TEXTURE_2D,0);
    glDisable(GL_TEXTURE_2D);

    glPopMatrix();
}

