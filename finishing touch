// ============================================================
// NEW: Classic arched stained-glass fanlight window + matching
// wall sconces, added to the back wall above the entrance door.
// All state changes (lighting/texture/blend) are pushed and
// popped so nothing here leaks into the rest of the scene.
// ============================================================

void drawWarmGlowLayer(
    float cx,float cy,float cz,
    float halfW,float halfH,
    float r,float g,float b,float a
)
{
    glColor4f(r,g,b,a);

    glBegin(GL_QUADS);

    glVertex3f(cx-halfW,cy-halfH,cz);
    glVertex3f(cx+halfW,cy-halfH,cz);
    glVertex3f(cx+halfW,cy+halfH,cz);
    glVertex3f(cx-halfW,cy+halfH,cz);

    glEnd();
}

// Soft additive "bloom" made of a few overlapping transparent
// quads. Depth writes are disabled so it can never occlude or be
// mistaken for solid geometry, and every state change is undone
// before returning (same technique already used by roomDarkness()).
void warmGlow(
    float cx,float cy,float cz,
    float halfW,float halfH
)
{
    glPushAttrib(
        GL_ENABLE_BIT |
        GL_CURRENT_BIT |
        GL_DEPTH_BUFFER_BIT |
        GL_COLOR_BUFFER_BIT
    );

    glDisable(GL_LIGHTING);
    glDisable(GL_TEXTURE_2D);

    glEnable(GL_BLEND);
    glBlendFunc(GL_SRC_ALPHA,GL_ONE);

    glDepthMask(GL_FALSE);

    drawWarmGlowLayer(
        cx,cy,cz,
        halfW*2.10f,halfH*2.10f,
        1.0f,0.50f,0.12f,0.045f
    );

    drawWarmGlowLayer(
        cx,cy,cz,
        halfW*1.55f,halfH*1.55f,
        1.0f,0.62f,0.18f,0.080f
    );

    drawWarmGlowLayer(
        cx,cy,cz,
        halfW*1.05f,halfH*1.05f,
        1.0f,0.75f,0.32f,0.130f
    );

    glDepthMask(GL_TRUE);

    glDisable(GL_BLEND);

    glPopAttrib();
}

// Classic arched (fanlight) stained-glass window, embedded into
// the back wall above the entrance door. Warm amber/gold/red/
// orange glass with a small blue-green accent, a dark wood frame
// and arch, and a subtle warm glow bleeding onto the wall.
//
//   x          : horizontal center of the window
//   baseY      : bottom of the rectangular glass section
//   z          : depth of the wall the window is embedded in
//   halfWidth  : half the overall width of the window
//   rectHeight : height of the rectangular section below the arch
//   archRadius : radius of the semicircular arch on top
void archedStainedGlassWindow(
    float x,float baseY,float z,
    float halfWidth,float rectHeight,float archRadius
)
{
    glPushAttrib(
        GL_ENABLE_BIT |
        GL_CURRENT_BIT |
        GL_LIGHTING_BIT
    );

    glDisable(GL_LIGHTING);
    glDisable(GL_TEXTURE_2D);

    const float springY = baseY + rectHeight;

    const float backZ  = z - 0.05f; // recessed backing, inside the wall
    const float glassZ = z + 0.00f; // glass sits just behind the frame
    const float frameZ = z + 0.10f; // wood trim, slightly proud of the wall

    // ---- Recess backing (gives the opening real depth/shadow) ----
    setColor(0.05f,0.045f,0.04f);

    cube(
        x,baseY+rectHeight/2.0f,backZ,
        halfWidth*2.0f+0.24f,
        rectHeight+0.20f,
        0.06f
    );

    // ---- Rectangular stained-glass grid (3 columns x 2 rows) ----
    float warmColors[5][3] =
    {
        {0.80f,0.50f,0.10f}, // amber
        {0.95f,0.78f,0.20f}, // golden yellow
        {0.55f,0.07f,0.06f}, // dark red
        {0.88f,0.42f,0.05f}, // orange
        {0.10f,0.40f,0.42f}  // small blue/green accent
    };

    int colorOrder[6] = {0,1,3,2,4,1};

    float gridW = halfWidth*2.0f - 0.24f;
    float gridH = rectHeight - 0.18f;

    float cellW = (gridW-0.10f)/3.0f;
    float cellH = (gridH-0.06f)/2.0f;

    float startX = x - gridW/2.0f + cellW/2.0f;
    float startY = baseY + 0.09f + cellH/2.0f;

    int idx = 0;

    for(int row=0; row<2; row++)
    {
        for(int col=0; col<3; col++)
        {
            float *c = warmColors[colorOrder[idx%6]];

            setColor(c[0],c[1],c[2]);

            cube(
                startX+col*(cellW+0.05f),
                startY+row*(cellH+0.06f),
                glassZ,
                cellW,
                cellH,
                0.045f
            );

            idx++;
        }
    }

    // ---- Semicircular fan of stained glass in the arch ----
    for(int a=10; a<=170; a+=20)
    {
        float rad = a*3.14159265f/180.0f;

        float px = x + (archRadius-0.14f)*cosf(rad);
        float py = springY + (archRadius-0.14f)*sinf(rad);

        int paletteIndex;

        if(a<=30 || a>=150)
            paletteIndex = 4; // blue/green accents near the base
        else if(a<70)
            paletteIndex = 2; // dark red
        else if(a<110)
            paletteIndex = 1; // golden yellow (crown of the fan)
        else
            paletteIndex = 3; // orange

        float *c = warmColors[paletteIndex];

        setColor(c[0],c[1],c[2]);

        cube(
            px,py,glassZ,
            0.36f,0.30f,0.045f
        );
    }

    // ---- Dark wooden frame ----
    setColor(0.30f,0.15f,0.05f);

    // Left post
    cube(
        x-halfWidth-0.08f,
        baseY+rectHeight/2.0f,
        frameZ,
        0.16f,
        rectHeight+0.16f,
        0.15f
    );

    // Right post
    cube(
        x+halfWidth+0.08f,
        baseY+rectHeight/2.0f,
        frameZ,
        0.16f,
        rectHeight+0.16f,
        0.15f
    );

    // Sill
    cube(
        x,
        baseY-0.09f,
        frameZ+0.03f,
        halfWidth*2.0f+0.34f,
        0.16f,
        0.22f
    );

    // Springer beam (base of the arch)
    cube(
        x,
        springY,
        frameZ,
        halfWidth*2.0f+0.22f,
        0.14f,
        0.15f
    );

    // Wooden arch ring
    for(int a=0; a<=180; a+=20)
    {
        float rad = a*3.14159265f/180.0f;

        float px = x + archRadius*cosf(rad);
        float py = springY + archRadius*sinf(rad);

        cube(
            px,py,frameZ,
            0.22f,0.22f,0.15f
        );
    }

    // Keystone
    cube(
        x,
        springY+archRadius+0.06f,
        frameZ,
        0.30f,0.24f,0.16f
    );

    glPopAttrib();

    // ---- Subtle warm glow bleeding onto the wall ----
    warmGlow(
        x,
        springY-rectHeight*0.15f,
        z+0.16f,
        halfWidth+0.35f,
        (rectHeight+archRadius)*0.55f
    );
}

// Simple elegant wall sconce: dark bracket + warm glowing "flame".
// Fully compatible with the existing low-poly rendering style
// (reuses cube/cylinder/sphere and setColor exactly like the
// rest of the file).
//
//   x,y,z : position on/near the wall
//   scale : uniform size multiplier (1.0 = default size)
void wallSconce(
    float x,float y,float z,
    float scale
)
{
    glPushAttrib(
        GL_ENABLE_BIT |
        GL_CURRENT_BIT
    );

    glDisable(GL_LIGHTING);
    glDisable(GL_TEXTURE_2D);

    glPushMatrix();

    glTranslatef(x,y,z);
    glScalef(scale,scale,scale);

    // Backplate against the wall
    setColor(0.10f,0.08f,0.06f);

    cube(
        0,0,0.03f,
        0.18f,0.42f,0.06f
    );

    // Arm reaching into the room
    cube(
        0,0.02f,0.16f,
        0.07f,0.07f,0.26f
    );

    // Cup / holder
    setColor(0.14f,0.11f,0.08f);

    cylinder(
        0,-0.06f,0.30f,
        0.10f,0.14f
    );

    // Warm glowing "flame"
    setColor(1.0f,0.72f,0.28f);

    sphere(
        0,0.14f,0.30f,
        0.10f
    );

    glPopMatrix();

    glPopAttrib();

    warmGlow(
        x,
        y+0.14f*scale,
        z+0.30f*scale+0.05f,
        0.30f*scale,
        0.30f*scale
    );
}

void magicalParticles(
    float x,float y,float z,
    float phase
)
{
    glDisable(GL_LIGHTING);

    glLineWidth(1.5f);

    const int stars = 7;

    for(int i=0;i<stars;i++)
    {
        float a =
            phase*0.65f + i*0.90f;

        float radius =
            0.24f + 0.035f*(i%3);

        float px =
            x + cosf(a*1.25f+i)*radius;

        float py =
            y + 0.34f +
            0.11f*sinf(a*1.8f+i);

        float pz =
            z + sinf(a*1.15f+i)*radius;

        float size =
            0.055f + 0.012f*(i%2);

        float glow =
            0.72f + 0.20f*sinf(a)*sinf(a);

        glColor3f(
            0.72f*glow,
            0.86f*glow,
            1.0f
        );

        glBegin(GL_LINES);

        glVertex3f(
            px-size,py,pz
        );

        glVertex3f(
            px+size,py,pz
        );

        glVertex3f(
            px,py-size,pz
        );

        glVertex3f(
            px,py+size,pz
        );

        glVertex3f(
            px,py,pz-size
        );

        glVertex3f(
            px,py,pz+size
        );

        glEnd();
    }

    glLineWidth(1.0f);

    glEnable(GL_LIGHTING);
}

