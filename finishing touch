void setupCamera()
{
    float rad =
        3.14159265f/180.0f;

    float yawr =
        yaw*rad;

    float pitchr =
        pitch*rad;

    float lookX =
        cos(pitchr)*sin(yawr);

    float lookY =
        sin(pitchr);

    float lookZ =
        cos(pitchr)*cos(yawr);

    gluLookAt(
        camX,
        camY,
        camZ,

        camX+lookX,
        camY+lookY,
        camZ+lookZ,

        0.0f,
        1.0f,
        0.0f
    );
}

// ============================================================
// LIGHTING: two light sources
//   LIGHT0 - warm positional ceiling lamp   (toggle with L)
//   LIGHT1 - cool directional daylight coming through the windows
// Positions are set AFTER gluLookAt so they live in world space.
// ============================================================
void setupLights()
{
    glEnable(GL_LIGHTING);
    glEnable(GL_NORMALIZE);
    resetDefaultMaterial();

    GLfloat globalAmb[] = {0.40f,0.40f,0.40f,1.0f};
    glLightModelfv(GL_LIGHT_MODEL_AMBIENT, globalAmb);
    glLightModeli(GL_LIGHT_MODEL_LOCAL_VIEWER, GL_TRUE);

    // ---- LIGHT0 : ceiling lamp (positional) ----
    GLfloat pos0[]  = {0.0f,7.0f,0.0f,1.0f};
    GLfloat amb0[]  = {0.15f,0.14f,0.12f,1.0f};
    GLfloat dif0[]  = {0.85f,0.82f,0.74f,1.0f};
    GLfloat spec0[] = {1.00f,1.00f,0.95f,1.0f};

    glLightfv(GL_LIGHT0, GL_POSITION, pos0);
    glLightfv(GL_LIGHT0, GL_AMBIENT,  amb0);
    glLightfv(GL_LIGHT0, GL_DIFFUSE,  dif0);
    glLightfv(GL_LIGHT0, GL_SPECULAR, spec0);

    if(lightsOn)
        glEnable(GL_LIGHT0);
    else
        glDisable(GL_LIGHT0);

    // ---- LIGHT1 : daylight from the windows (directional, w = 0) ----
    GLfloat pos1[]  = {0.25f,0.55f,1.0f,0.0f};
    GLfloat amb1[]  = {0.10f,0.11f,0.14f,1.0f};
    GLfloat dif1[]  = {0.45f,0.50f,0.60f,1.0f};
    GLfloat spec1[] = {0.60f,0.65f,0.80f,1.0f};

    glLightfv(GL_LIGHT1, GL_POSITION, pos1);
    glLightfv(GL_LIGHT1, GL_AMBIENT,  amb1);
    glLightfv(GL_LIGHT1, GL_DIFFUSE,  dif1);
    glLightfv(GL_LIGHT1, GL_SPECULAR, spec1);
    glEnable(GL_LIGHT1);
}

void display()
{
    glClear(
        GL_COLOR_BUFFER_BIT |
        GL_DEPTH_BUFFER_BIT
    );

    glMatrixMode(GL_MODELVIEW);

    glLoadIdentity();

    setupCamera();

    setupLights();

    scene();

    drawDarkScreen();

    glutSwapBuffers();
}

// ============================================================
// NEW: bookshelf collision so the player can no longer walk
// into a shelf and end up looking at the plain back panel.
// ============================================================
bool blockedByBookshelf(float x, float z)
{
    const float r = 0.38f; // same player radius used below

    struct Shelf
    {
        float cx, cz;        // center in world space
        float halfX, halfZ;  // half-extent in world space
    };

    Shelf shelves[] =
    {
        // Side wall bookshelves (rotated 90 / -90):
        // their "width" (15.6) runs along Z, "depth" (1.15) runs along X
        { -8.45f, 0.0f, 0.575f + r, 7.80f + r },
        {  8.45f, 0.0f, 0.575f + r, 7.80f + r },

        // Corner bookshelves near the back wall (4.2 wide x 0.48 deep)
        { -5.65f, -7.50f, 2.10f + r, 0.24f + r },
        {  5.65f, -7.50f, 2.10f + r, 0.24f + r },

        // Four free-standing bookshelves (2.7 wide x 0.62 deep)
        { -5.6f, -0.55f, 1.35f + r, 0.31f + r },
        {  5.6f, -0.55f, 1.35f + r, 0.31f + r },
        { -5.6f,  3.10f, 1.35f + r, 0.31f + r },
        {  5.6f,  3.10f, 1.35f + r, 0.31f + r },

        // Full rear wall bookshelf (21.3 wide x 0.62 deep)
        {  0.0f, 9.35f, 10.65f + r, 0.31f + r }
    };

    const int count = sizeof(shelves) / sizeof(shelves[0]);

    for (int i = 0; i < count; i++)
    {
        if (x > shelves[i].cx - shelves[i].halfX &&
            x < shelves[i].cx + shelves[i].halfX &&
            z > shelves[i].cz - shelves[i].halfZ &&
            z < shelves[i].cz + shelves[i].halfZ)
        {
            return true;
        }
    }

    return false;
}

bool blocked(
    float x,
    float z
)
{
    const float r = 0.38f;

    // Keep player inside library
    if(
        x < -9.55f ||
        x > 9.55f ||
        z < -9.15f ||
        z > 9.15f
    )
        return true;

    const float tx[] =
    {
        -3.2f,
        3.2f,
        -3.2f,
        3.2f,
        0.0f
    };

    const float tz[] =
    {
        -3.4f,
        -3.4f,
        1.2f,
        1.2f,
        5.2f
    };

    for(int i=0;i<5;i++)
    {
        if(
            x > tx[i]-1.55f-r &&
            x < tx[i]+1.55f+r &&
            z > tz[i]-0.92f-r &&
            z < tz[i]+0.92f+r
        )
            return true;
    }

    // exhibit pedestal
    if(
        x > -0.55f-r && x < 0.55f+r &&
        z > ORB_HOME_Z-0.55f-r && z < ORB_HOME_Z+0.55f+r
    )
        return true;

    // NEW: block movement into any bookshelf
    if(blockedByBookshelf(x, z))
        return true;

    return false;
}

void tryMove(
    float dx,
    float dz
)
{
    float nx =
        camX + dx;

    float nz =
        camZ + dz;

    if(
        !blocked(
            nx,
            camZ
        )
    )
        camX = nx;

    if(
        !blocked(
            camX,
            nz
        )
    )
        camZ = nz;
}

void update(int value)
{
    // ---------- exhibit: TRANSLATION (arrow keys, PgUp/PgDn) ----------
    const float ts = 0.04f;
    if(specialKeys[GLUT_KEY_LEFT])      exX -= ts;
    if(specialKeys[GLUT_KEY_RIGHT])     exX += ts;
    if(specialKeys[GLUT_KEY_UP])        exZ -= ts;
    if(specialKeys[GLUT_KEY_DOWN])      exZ += ts;
    if(specialKeys[GLUT_KEY_PAGE_UP])   exY += ts;
    if(specialKeys[GLUT_KEY_PAGE_DOWN]) exY -= ts;

    // ---------- exhibit: ROTATION (Z/X = Y axis, C/V = X axis, B/N = Z axis) ----------
    const float rs = 2.0f;
    if(keys['z'] || keys['Z']) exRotY -= rs;
    if(keys['x'] || keys['X']) exRotY += rs;
    if(keys['c'] || keys['C']) exRotX -= rs;
    if(keys['v'] || keys['V']) exRotX += rs;
    if(keys['b'] || keys['B']) exRotZ -= rs;
    if(keys['n'] || keys['N']) exRotZ += rs;

    // ---------- exhibit: SCALING (+ / -  or mouse wheel) ----------
    if(keys['+'] || keys['=']) exScale *= 1.02f;
    if(keys['-'] || keys['_']) exScale /= 1.02f;

    if(exScale < 0.4f) exScale = 0.4f;
    if(exScale > 2.2f) exScale = 2.2f;
    if(exX < -8.0f) exX = -8.0f;
    if(exX >  8.0f) exX =  8.0f;
    if(exZ < -7.0f) exZ = -7.0f;
    if(exZ >  8.0f) exZ =  8.0f;
    if(exY < -0.4f) exY = -0.4f;
    if(exY >  3.8f) exY =  3.8f;

    // ---------- continuous animation ----------
    if(exAutoSpin) exSpinAngle += 1.2f;
    if(exSpinAngle >= 360.0f) exSpinAngle -= 360.0f;

    moonAngle += 3.0f;
    if(moonAngle >= 360.0f) moonAngle -= 360.0f;

    skyTime += 0.016f;

    float targetDoorAngle =
        doubleDoorOpen ?
        88.0f :
        0.0f;

    float doorSpeed = 4.0f;

    if(
        doubleDoorAngle <
        targetDoorAngle
    )
    {
        doubleDoorAngle =
            fminf(
                doubleDoorAngle +
                doorSpeed,
                targetDoorAngle
            );
    }
    else if(
        doubleDoorAngle >
        targetDoorAngle
    )
    {
        doubleDoorAngle =
            fmaxf(
                doubleDoorAngle -
                doorSpeed,
                targetDoorAngle
            );
    }


    // Continuous ceiling fan
    fanAngle += fanSpeed;

    if(
        fanAngle >= 360.0f
    )
        fanAngle -= 360.0f;


    // Magical books
    magicBookPulse += 0.10f;

    for(int i=0;i<2;i++)
    {
        float targetLift =
            magicBookActive[i] ?
            0.22f :
            0.0f;

        if(
            magicBookLift[i] <
            targetLift
        )
        {
            magicBookLift[i] =
                fminf(
                    magicBookLift[i]+0.012f,
                    targetLift
                );
        }
        else if(
            magicBookLift[i] >
            targetLift
        )
        {
            magicBookLift[i] =
                fmaxf(
                    magicBookLift[i]-0.012f,
                    targetLift
                );
        }
    }

    if(
        fanAngle >= 360.0f
    )
        fanAngle -= 360.0f;


    float rad =
        3.14159265f/180.0f;

    float yawr =
        yaw*rad;

    float forwardX =
        sin(yawr);

    float forwardZ =
        cos(yawr);

    float rightX =
        -cos(yawr);

    float rightZ =
        sin(yawr);

    bool shiftPressed =
        (GetAsyncKeyState(VK_SHIFT)&0x8000);

    float speed =
        shiftPressed ?
        0.22f :
        0.10f;


    if(
        keys['w'] ||
        keys['W']
    )
    {
        tryMove(
            forwardX*speed,
            forwardZ*speed
        );
    }

    if(
        keys['s'] ||
        keys['S']
    )
    {
        tryMove(
            -forwardX*speed,
            -forwardZ*speed
        );
    }

    if(
        keys['a'] ||
        keys['A']
    )
    {
        tryMove(
            -rightX*speed,
            -rightZ*speed
        );
    }

    if(
        keys['d'] ||
        keys['D']
    )
    {
        tryMove(
            rightX*speed,
            rightZ*speed
        );
    }


    if(camX < -10.3f)
        camX = -10.2f;

    if(camX > 10.3f)
        camX = 10.2f;

    if(camZ < -9.3f)
        camZ = -9.2f;

    if(camZ > 9.3f)
        camZ = 9.2f;


    glutPostRedisplay();

    glutTimerFunc(
        16,
        update,
        0
    );
}

void keyDown(
    unsigned char key,
    int x,
    int y
)
{
    if(
        key=='e' ||
        key=='E'
    )
        doubleDoorOpen =
            !doubleDoorOpen;


    // M = both magical books
    if(
        key=='m' ||
        key=='M'
    )
    {
        magicBookOpen =
            !magicBookOpen;

        magicBookActive[0] =
            magicBookOpen;

        magicBookActive[1] =
            magicBookOpen;
    }


    // F = fan speed
    if(
        key=='f' ||
        key=='F'
    )
    {
        if(fanSpeed < 0.5f)
            fanSpeed = 4.0f;

        else if(fanSpeed < 6.0f)
            fanSpeed = 8.0f;

        else if(fanSpeed < 10.0f)
            fanSpeed = 14.0f;

        else
            fanSpeed = 0.0f;
    }


    // L = light
    if(
        key=='l' ||
        key=='L'
    )
        lightsOn =
            !lightsOn;


    // T = toggle continuous spin of the exhibit
    if(
        key=='t' ||
        key=='T'
    )
        exAutoSpin =
            !exAutoSpin;


    keys[key] = true;


    if(key == 27)
        exit(0);


    if(
        key == 'r' ||
        key == 'R'
    )
    {
        camX = 0.0f;
        camY = 1.75f;
        camZ = 7.0f;

        yaw = 180.0f;
        pitch = 0.0f;

        resetExhibit();

        warping = true;

        glutWarpPointer(
            centerX,
            centerY
        );
    }
}

void specialDown(
    int key,
    int x,
    int y
)
{
    if(key >= 0 && key < 256)
        specialKeys[key] = true;
}

void specialUp(
    int key,
    int x,
    int y
)
{
    if(key >= 0 && key < 256)
        specialKeys[key] = false;
}

void keyUp(
    unsigned char key,
    int x,
    int y
)
{
    keys[key] = false;
}

void mouseMove(
    int x,
    int y
)
{
    if(warping)
    {
        warping = false;
        return;
    }

    int dx =
        x-centerX;

    int dy =
        y-centerY;

    float sensitivity =
        0.18f;

    yaw -=
        dx*sensitivity;

    pitch -=
        dy*sensitivity;


    if(yaw > 360.0f)
        yaw -= 360.0f;

    if(yaw < 0.0f)
        yaw += 360.0f;


    if(pitch > 85.0f)
        pitch = 85.0f;

    if(pitch < -85.0f)
        pitch = -85.0f;


    warping = true;

    glutWarpPointer(
        centerX,
        centerY
    );

    glutPostRedisplay();
}

void reshape(
    int w,
    int h
)
{
    if(h == 0)
        h = 1;

    centerX =
        w/2;

    centerY =
        h/2;

    glViewport(
        0,
        0,
        w,
        h
    );

    glMatrixMode(
        GL_PROJECTION
    );

    glLoadIdentity();

    gluPerspective(
        70.0,
        (float)w/(float)h,
        0.1,
        100.0
    );

    glMatrixMode(
        GL_MODELVIEW
    );
}

void init()
{
    glClearColor(
        0.72f,
        0.72f,
        0.72f,
        1.0f
    );

    glEnable(
        GL_DEPTH_TEST
    );

    glDisable(
        GL_LIGHTING
    );

    glDisable(
        GL_FOG
    );

    glShadeModel(
        GL_SMOOTH
    );


    GLfloat lightPos[] =
    {
        0.0f,
        7.0f,
        1.5f,
        1.0f
    };

    GLfloat lightDiffuse[] =
    {
        1.0f,
        0.96f,
        0.90f,
        1.0f
    };

    GLfloat lightSpecular[] =
    {
        1.0f,
        1.0f,
        1.0f,
        1.0f
    };

    glLightfv(
        GL_LIGHT0,
        GL_POSITION,
        lightPos
    );

    glLightfv(
        GL_LIGHT0,
        GL_DIFFUSE,
        lightDiffuse
    );

    glLightfv(
        GL_LIGHT0,
        GL_SPECULAR,
        lightSpecular
    );


    GLfloat ambient[] =
    {
        0.20f,
        0.20f,
        0.20f,
        1.0f
    };

    glLightModelfv(
        GL_LIGHT_MODEL_AMBIENT,
        ambient
    );


    glEnable(
        GL_TEXTURE_2D
    );

    glTexEnvi(
        GL_TEXTURE_ENV,
        GL_TEXTURE_ENV_MODE,
        GL_MODULATE
    );


    makeProceduralTexture(
        texWood,
        0
    );

    makeProceduralTexture(
        texTile,
        1
    );

    makeProceduralTexture(
        texWall,
        2
    );

    makeProceduralTexture(
        texDecorTile,
        3
    );


    glDisable(
        GL_TEXTURE_2D
    );


    glutSetCursor(
        GLUT_CURSOR_NONE
    );
}

int main(
    int argc,
    char** argv
)
{
    glutInit(
        &argc,
        argv
    );

    glutInitDisplayMode(
        GLUT_DOUBLE |
        GLUT_RGB |
        GLUT_DEPTH
    );

    glutInitWindowSize(
        1200,
        800
    );

    glutInitWindowPosition(
        80,
        40
    );

    glutCreateWindow(
        "Grand 3D Library - WASD Move | Mouse Look | Arrows/PgUp/PgDn Move Orb | Z/X C/V B/N Rotate Orb | +/- or Wheel Scale | T Spin | CLICK Computer/Book | M Books | F Fan | L Light | E Door | R Reset"
    );


    init();


    glutDisplayFunc(
        display
    );

    glutReshapeFunc(
        reshape
    );

    glutKeyboardFunc(
        keyDown
    );

    glutKeyboardUpFunc(
        keyUp
    );

    glutSpecialFunc(
        specialDown
    );

    glutSpecialUpFunc(
        specialUp
    );

    glutPassiveMotionFunc(
        mouseMove
    );

    glutMouseFunc(
        handleMouseClick
    );

    glutTimerFunc(
        16,
        update,
        0
    );


    glutMainLoop();

    return 0;
}

