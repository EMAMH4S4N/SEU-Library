const float ORB_HOME_Y =  2.0f;
const float ORB_HOME_Z = -1.1f;

void exhibitPedestal()
{
    glPushAttrib(GL_ENABLE_BIT | GL_LIGHTING_BIT | GL_CURRENT_BIT);

    // polished textured wood (explicit ambient/diffuse/specular)
    useMaterial(matPolishedWood);

    texturedCube(0.0f,0.12f,ORB_HOME_Z, 1.10f,0.24f,1.10f, texWood,2.0f,1.0f);
    texturedCube(0.0f,0.78f,ORB_HOME_Z, 0.55f,1.08f,0.55f, texWood,1.0f,2.0f);
    texturedCube(0.0f,1.37f,ORB_HOME_Z, 0.90f,0.10f,0.90f, texWood,2.0f,1.0f);

    // gold trim on top
    glDisable(GL_TEXTURE_2D);
    useMaterial(matGold);
    cube(0.0f,1.44f,ORB_HOME_Z, 0.95f,0.04f,0.95f);

    glPopAttrib();
}

void orbExhibit()
{
    glPushAttrib(GL_ENABLE_BIT | GL_LIGHTING_BIT | GL_CURRENT_BIT);
    glDisable(GL_TEXTURE_2D);

    glPushMatrix();

    // --- object-coordinate transformations, user controlled ---
    glTranslatef(ORB_HOME_X+exX, ORB_HOME_Y+exY, ORB_HOME_Z+exZ); // translation
    glRotatef(exRotX,1,0,0);                                      // rotation X
    glRotatef(exRotY+exSpinAngle,0,1,0);                          // rotation Y (+ continuous spin)
    glRotatef(exRotZ,0,0,1);                                      // rotation Z
    glScalef(exScale,exScale,exScale);                            // scaling

    // glass core
    useMaterial(matTeal);
    glutSolidSphere(0.24,32,32);

    // golden rings + axis rod
    useMaterial(matGold);

    glPushMatrix();
    glRotatef(90,1,0,0);
    glutSolidTorus(0.016,0.44,16,64);   // equatorial ring
    glPopMatrix();

    glutSolidTorus(0.016,0.52,16,64);   // meridian ring

    glPushMatrix();
    glRotatef(90,0,1,0);
    glutSolidTorus(0.016,0.60,16,64);   // second meridian ring
    glPopMatrix();

    cube(0.0f,0.0f,0.0f, 0.03f,1.32f,0.03f);   // axis rod
    sphere(0.0f, 0.66f,0.0f, 0.05f);
    sphere(0.0f,-0.66f,0.0f, 0.05f);

    // two orbiting moons
    useMaterial(matMoon);

    glPushMatrix();
    glRotatef(moonAngle,0,1,0);
    glTranslatef(0.44f,0.0f,0.0f);
    glutSolidSphere(0.065,20,20);
    glPopMatrix();

    glPushMatrix();
    glRotatef(35,0,0,1);
    glRotatef(-moonAngle*1.6f,0,1,0);
    glTranslatef(0.60f,0.0f,0.0f);
    glutSolidSphere(0.05,20,20);
    glPopMatrix();

    glPopMatrix();

    glPopAttrib();
}

