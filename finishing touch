void ceiling()
{
    setColor(0.97f,0.97f,0.97f);

    cube(
        0,7.9f,0,
        22.0f,0.25f,20.0f
    );

    glPushAttrib(
        GL_ENABLE_BIT |
        GL_CURRENT_BIT |
        GL_LIGHTING_BIT
    );

    glDisable(GL_TEXTURE_2D);

    const int panelCols = 6;
    const int panelRows = 6;

    const float gridW = 21.0f;
    const float gridD = 19.0f;

    const float cellW = gridW / panelCols;
    const float cellD = gridD / panelRows;

    const float beamY  = 7.70f; // grid beams, hang lower (more visible)
    const float panelY = 7.76f; // recessed panel faces, closer to the slab

    setColor(0.30f,0.21f,0.12f);

    for(int r=0; r<=panelRows; r++)
    {
        float z = -gridD/2.0f + r*cellD;

        cube(
            0.0f,beamY,z,
            gridW,0.08f,0.10f
        );
    }

    for(int c=0; c<=panelCols; c++)
    {
        float x = -gridW/2.0f + c*cellW;

        cube(
            x,beamY,0.0f,
            0.10f,0.08f,gridD
        );
    }

    for(int r=0; r<panelRows; r++)
    {
        for(int c=0; c<panelCols; c++)
        {
            float px = -gridW/2.0f + (c+0.5f)*cellW;
            float pz = -gridD/2.0f + (r+0.5f)*cellD;

            bool alt = ((r+c)%2)==0;

            setColor(
                alt ? 0.90f : 0.86f,
                alt ? 0.90f : 0.86f,
                alt ? 0.88f : 0.84f
            );

            cube(
                px,panelY,pz,
                cellW-0.14f,0.03f,cellD-0.14f
            );
        }
    }

    glPopAttrib();
}

