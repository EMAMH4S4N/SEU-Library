void cube(float x,float y,float z,float sx,float sy,float sz)
{
    glPushMatrix();

    glTranslatef(x,y,z);
    glScalef(sx,sy,sz);

    glutSolidCube(1.0f);

    glPopMatrix();
}

void sphere(float x,float y,float z,float r)
{
    glPushMatrix();

    glTranslatef(x,y,z);

    glutSolidSphere(r,20,20);

    glPopMatrix();
}

void cylinder(float x,float y,float z,float r,float h)
{
    GLUquadric* q = gluNewQuadric();

    glPushMatrix();

    glTranslatef(x,y,z);
    glRotatef(-90,1,0,0);

    gluCylinder(q,r,r,h,24,2);

    gluDisk(q,0,r,24,1);

    glTranslatef(0,0,h);

    gluDisk(q,0,r,24,1);

    glPopMatrix();

    gluDeleteQuadric(q);
}

