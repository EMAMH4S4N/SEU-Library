    cube(x,y,z,
         0.18f,2.8f,3.0f);

    glColor3f(0.25f,0.65f,0.90f);

    cube(x+0.11f,y,z,
         0.04f,2.40f,2.60f);

    glColor3f(0.90f,0.90f,0.85f);

    cube(x+0.15f,y,z,
         0.06f,2.55f,0.10f);

    cube(x+0.15f,y,z,
         0.06f,0.10f,2.70f);
}
