        glutSolidCube(1.0f);
        glPopMatrix();

        glPopMatrix();
    }

    // Center cap
    sphere(0,0,0,0.22f);

    glPopMatrix();
}


void tableTop(float x,float y,float z,float w,float d,float h)
{
    beginGlossyWood();

    // Rounded/octagonal tabletop made from an extruded 8-sided polygon.
    float hw = w/2.0f;
    float hd = d/2.0f;
    float cut = 0.28f;

    float vx[8] =
    {
        -hw+cut, hw-cut, hw, hw,
         hw-cut,-hw+cut,-hw,-hw
    };

    float vz[8] =
    {
        -hd,-hd,-hd+cut,hd-cut,
         hd,hd,hd-cut,-hd+cut
    };

    glEnable(GL_TEXTURE_2D);
    glBindTexture(GL_TEXTURE_2D,texWood);
    glColor3f(1,1,1);

    glBegin(GL_QUADS);
    for(int i=0;i<8;i++)
    {
        int j=(i+1)%8;

        glTexCoord2f(0,0); glVertex3f(x+vx[i],y+h/2,z+vz[i]);
        glTexCoord2f(1,0); glVertex3f(x+vx[j],y+h/2,z+vz[j]);
        glTexCoord2f(1,1); glVertex3f(x+vx[j],y-h/2,z+vz[j]);
        glTexCoord2f(0,1); glVertex3f(x+vx[i],y-h/2,z+vz[i]);
    }
    glEnd();

    glBegin(GL_POLYGON);
    for(int i=0;i<8;i++) {
        glTexCoord2f((vx[i]+hw)/(2*hw), (vz[i]+hd)/(2*hd));
        glVertex3f(x+vx[i],y+h/2+0.015f,z+vz[i]);
    }
    glEnd();

    glBegin(GL_POLYGON);
    for(int i=7;i>=0;i--) {
        glTexCoord2f((vx[i]+hw)/(2*hw), (vz[i]+hd)/(2*hd));
        glVertex3f(x+vx[i],y-h/2-0.015f,z+vz[i]);
    }
    glEnd();
    glBindTexture(GL_TEXTURE_2D,0);
    glDisable(GL_TEXTURE_2D);
    endGlossyWood();
}

