    floor();
    walls();

    // Centered double wooden entrance.
    doubleWoodDoor(0.0f,0.0f,-7.78f);

    /*
       BACK WALL
       The door/window wall stays open in the center.
    */
    /*
       THREE WALL BOOKSHELVES
       Left + right walls are full.
       Back wall has shelves on both sides of the door/windows.
    */
    sideWallBookshelf(-8.45f,-0.05f,0.0f,90.0f);
    sideWallBookshelf(8.45f,-0.05f,0.0f,-90.0f);

    bookshelf(-5.65f,-0.95f,-7.50f,4.2f,5.35f,0.48f);
    bookshelf(5.65f,-0.05f,-7.50f,4.2f,5.9f,0.48f);

    /*
