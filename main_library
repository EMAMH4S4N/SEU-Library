void railing(float x,float y,float z,
             float length,float angle)
{
    glPushMatrix();

    glTranslatef(x,y,z);
    glRotatef(angle,0,1,0);

    setColor(0.55f,0.30f,0.10f);

    cube(0,0,0,length,0.10f,0.10f);

    for(float i=-length/2;
        i<=length/2;
        i+=0.35f)
    {
        cube(i,-0.40f,0,
             0.07f,0.80f,0.07f);
    }

    glPopMatrix();
}

void staircase()
{
    for(int i=0;i<13;i++)
    {
        float x=-6.0f+i*0.40f;
        float y=0.15f+i*0.25f;

        setColor(0.58f,0.35f,0.15f);

        cube(x,y,1.0f,
             0.75f,
             0.20f,
             1.70f);
    }

    railing(-3.6f,3.30f,0.25f,5.2f,0);
    railing(-3.6f,3.30f,1.75f,5.2f,0);
}

