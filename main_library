void setupCamera()
{
    float yawr=yaw*3.14159265f/180.0f;
    float pitchr=pitch*3.14159265f/180.0f;

    float lookX=cos(pitchr)*sin(yawr);
    float lookY=sin(pitchr);
    float lookZ=cos(pitchr)*cos(yawr);

    gluLookAt(
        camX,
        camY,
        camZ,

        camX+lookX,
        camY+lookY,
        camZ+lookZ,

        0,1,0
    );
}

void display()
{
    glClear(GL_COLOR_BUFFER_BIT|GL_DEPTH_BUFFER_BIT);

    glMatrixMode(GL_MODELVIEW);
    glLoadIdentity();

    setupCamera();
    scene();

    glutSwapBuffers();
}

void update(int value)
{
    float yawr=yaw*3.14159265f/180.0f;

    float forwardX=sin(yawr);
    float forwardZ=cos(yawr);

    float rightX=-cos(yawr);
    float rightZ=sin(yawr);

    bool shiftPressed=
        (GetAsyncKeyState(VK_SHIFT)&0x8000);

    moveSpeed=
        shiftPressed ? 0.22f : 0.10f;

    if(keys['w']||keys['W'])
    {
        camX+=forwardX*moveSpeed;
        camZ+=forwardZ*moveSpeed;
    }

    if(keys['s']||keys['S'])
    {
        camX-=forwardX*moveSpeed;
        camZ-=forwardZ*moveSpeed;
    }

    if(keys['a']||keys['A'])
    {
        camX-=rightX*moveSpeed;
        camZ-=rightZ*moveSpeed;
    }

    if(keys['d']||keys['D'])
    {
        camX+=rightX*moveSpeed;
        camZ+=rightZ*moveSpeed;
    }

    if(camX<-8.2f) camX=-8.2f;
    if(camX>8.2f) camX=8.2f;

    if(camZ<-7.2f) camZ=-7.2f;
    if(camZ>7.2f) camZ=7.2f;

    glutPostRedisplay();

    glutTimerFunc(16,update,0);
}

void keyDown(unsigned char key,int x,int y)
{
    keys[key]=true;

    if(key==27)
        exit(0);

    if(key=='r'||key=='R')
    {
        camX=0.0f;
        camY=1.75f;
        camZ=7.0f;

        yaw=180.0f;
        pitch=0.0f;
    }
}

void keyUp(unsigned char key,int x,int y)
{
    keys[key]=false;
}

void mouseMove(int x,int y)
{
    if(warping)
    {
        warping=false;
        return;
    }

    int dx=x-centerX;
    int dy=y-centerY;

    float sensitivity=0.18f;

    yaw+=dx*sensitivity;
    pitch-=dy*sensitivity;

    if(pitch>85.0f)
        pitch=85.0f;

    if(pitch<-85.0f)
        pitch=-85.0f;

    warping=true;

    glutWarpPointer(centerX,centerY);

    glutPostRedisplay();
}

void reshape(int w,int h)
{
    if(h==0)
        h=1;

    centerX=w/2;
    centerY=h/2;

    glViewport(0,0,w,h);

    glMatrixMode(GL_PROJECTION);
    glLoadIdentity();

    gluPerspective(
        70.0,
        (float)w/(float)h,
        0.1,
        100.0
    );

    glMatrixMode(GL_MODELVIEW);
}

void init()
{
    glClearColor(
        0.55f,
        0.65f,
        0.75f,
        1.0f
    );

    glEnable(GL_DEPTH_TEST);

    glDisable(GL_LIGHTING);
    glDisable(GL_FOG);

    glShadeModel(GL_SMOOTH);

    glutSetCursor(GLUT_CURSOR_NONE);
}

int main(int argc,char** argv)
{
    glutInit(&argc,argv);

    glutInitDisplayMode(
        GLUT_DOUBLE|
        GLUT_RGB|
        GLUT_DEPTH
    );

    glutInitWindowSize(1200,800);

    glutInitWindowPosition(80,40);

    glutCreateWindow(
        "3D Library Environment - Graphics Lab"
    );

    init();

    glutDisplayFunc(display);
    glutReshapeFunc(reshape);

    glutKeyboardFunc(keyDown);
    glutKeyboardUpFunc(keyUp);

    glutPassiveMotionFunc(mouseMove);

    glutTimerFunc(16,update,0);

    glutMainLoop();

    return 0;
}
