void arch(float x,float z,float width)
{
    setColor(0.34f,0.16f,0.055f);

    cube(x-width/2,4.15f,z,
         0.32f,3.8f,0.45f);

    cube(x+width/2,4.15f,z,
         0.32f,3.8f,0.45f);

    cube(x,6.0f,z,
         width+0.32f,0.35f,0.45f);

    for(float a=0;a<=180;a+=15)
    {
        float rad=a*3.14159265f/180.0f;
        float px=x+(width/2)*cos(rad);
        float py=6.0f+(width/2)*sin(rad);

        cube(px,py,z,
             0.28f,0.28f,0.45f);
    }
}

