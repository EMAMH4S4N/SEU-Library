void setupCamera()
{
    float rad = 3.14159265f/180.0f;

    float yawr = yaw*rad;
    float pitchr = pitch*rad;

    float lookX = cos(pitchr)*sin(yawr);
    float lookY = sin(pitchr);
    float lookZ = cos(pitchr)*cos(yawr);

    gluLookAt(
        camX,
        camY,
        camZ,

        camX+lookX,
        camY+lookY,
        camZ+lookZ,

        0.0f,
        1.0f,
        0.0f
    );
}

void display()
{
    glClear(
        GL_COLOR_BUFFER_BIT |
        GL_DEPTH_BUFFER_BIT
    );

    glMatrixMode(GL_MODELVIEW);
    glLoadIdentity();

    setupCamera();
    scene();

    glutSwapBuffers();
}


bool blocked(float x,float z)
{
    const float r = 0.38f;

    // Keep player inside the library.
    if(x < -7.55f || x > 7.55f || z < -7.15f || z > 7.15f)
        return true;

    // Table collision boxes.
    const float tx[] = {-3.2f, 3.2f, -3.2f, 3.2f, 0.0f};
    const float tz[] = {-3.4f,-3.4f, 1.2f, 1.2f, 5.2f};

    for(int i=0;i<5;i++)
    {
        if(x > tx[i]-1.55f-r && x < tx[i]+1.55f+r &&
           z > tz[i]-0.92f-r && z < tz[i]+0.92f+r)
            return true;
    }

    return false;
}

void tryMove(float dx,float dz)
{
    float nx = camX + dx;
    float nz = camZ + dz;

    // Separate X/Z tests let the player slide around corners
    // instead of getting stuck.
    if(!blocked(nx,camZ))
        camX = nx;

    if(!blocked(camX,nz))
        camZ = nz;
}

void update(int value)
{
    float targetDoorAngle = doubleDoorOpen ? 88.0f : 0.0f;
    float doorSpeed = 4.0f;
    if(doubleDoorAngle < targetDoorAngle)
        doubleDoorAngle = fminf(doubleDoorAngle + doorSpeed, targetDoorAngle);
    else if(doubleDoorAngle > targetDoorAngle)
        doubleDoorAngle = fmaxf(doubleDoorAngle - doorSpeed, targetDoorAngle);

    // Continuous ceiling-fan rotation
    fanAngle += 8.0f;
    if(fanAngle >= 360.0f)
        fanAngle -= 360.0f;

    float rad = 3.14159265f/180.0f;

    float yawr = yaw*rad;

    float forwardX = sin(yawr);
    float forwardZ = cos(yawr);

    float rightX = -cos(yawr);
    float rightZ = sin(yawr);

    bool shiftPressed =
        (GetAsyncKeyState(VK_SHIFT)&0x8000);

    float speed =
        shiftPressed ? 0.22f : 0.10f;

    if(keys['w'] || keys['W'])
    {
        tryMove(forwardX*speed, forwardZ*speed);
    }

    if(keys['s'] || keys['S'])
    {
        tryMove(-forwardX*speed, -forwardZ*speed);
    }

    if(keys['a'] || keys['A'])
    {
        tryMove(-rightX*speed, -rightZ*speed);
    }

    if(keys['d'] || keys['D'])
    {
        tryMove(rightX*speed, rightZ*speed);
    }

    if(camX < -8.3f)
        camX = -8.2f;

    if(camX > 8.3f)
        camX = 8.2f;

    if(camZ < -7.3f)
        camZ = -7.2f;

    if(camZ > 7.3f)
        camZ = 7.2f;

    glutPostRedisplay();

    glutTimerFunc(16,update,0);
}

void keyDown(unsigned char key,int x,int y)
{
    if(key=='e' || key=='E') doubleDoorOpen = !doubleDoorOpen;

    keys[key] = true;

    if(key == 27)
        exit(0);
    if(key == 'r' || key == 'R')
    {
        camX = 0.0f;
        camY = 1.75f;
        camZ = 7.0f;

        yaw = 180.0f;
        pitch = 0.0f;

        warping = true;

        glutWarpPointer(centerX,centerY);
    }
}

void keyUp(unsigned char key,int x,int y)
{
    keys[key] = false;
}

void mouseMove(int x,int y)
{
    if(warping)
    {
        warping = false;
        return;
    }

    int dx = x-centerX;
    int dy = y-centerY;

    float sensitivity = 0.18f;

    yaw -= dx*sensitivity;
    pitch -= dy*sensitivity;

    if(yaw > 360.0f)
        yaw -= 360.0f;

    if(yaw < 0.0f)
        yaw += 360.0f;

    if(pitch > 85.0f)
        pitch = 85.0f;

    if(pitch < -85.0f)
        pitch = -85.0f;

    warping = true;

    glutWarpPointer(centerX,centerY);

    glutPostRedisplay();
}

void reshape(int w,int h)
{
    if(h == 0)
        h = 1;

    centerX = w/2;
    centerY = h/2;

    glViewport(0,0,w,h);

    glMatrixMode(GL_PROJECTION);
    glLoadIdentity();

    gluPerspective(
        70.0,
        (float)w/(float)h,
        0.1,
        100.0
    );

    glMatrixMode(GL_MODELVIEW);
}

void init()
{
    glClearColor(
        0.72f,
        0.72f,
        0.72f,
        1.0f
    );

    glEnable(GL_DEPTH_TEST);

    glDisable(GL_LIGHTING);
    glDisable(GL_FOG);

    glShadeModel(GL_SMOOTH);

    // Soft light for visible polished-wood highlights.
    GLfloat lightPos[] = {0.0f,7.0f,1.5f,1.0f};
    GLfloat lightDiffuse[] = {1.0f,0.96f,0.90f,1.0f};
    GLfloat lightSpecular[] = {1.0f,1.0f,1.0f,1.0f};
    glLightfv(GL_LIGHT0,GL_POSITION,lightPos);
    glLightfv(GL_LIGHT0,GL_DIFFUSE,lightDiffuse);
    glLightfv(GL_LIGHT0,GL_SPECULAR,lightSpecular);
    GLfloat ambient[] = {0.20f,0.20f,0.20f,1.0f};
    glLightModelfv(GL_LIGHT_MODEL_AMBIENT,ambient);

    glEnable(GL_TEXTURE_2D);
    glTexEnvi(GL_TEXTURE_ENV, GL_TEXTURE_ENV_MODE, GL_MODULATE);

    makeProceduralTexture(texWood,0);
    makeProceduralTexture(texTile,1);
    makeProceduralTexture(texWall,2);

    glDisable(GL_TEXTURE_2D);

    glutSetCursor(GLUT_CURSOR_NONE);
}

int main(int argc,char** argv)
{
    glutInit(&argc,argv);

    glutInitDisplayMode(
        GLUT_DOUBLE |
        GLUT_RGB |
        GLUT_DEPTH
    );

    glutInitWindowSize(1200,800);

    glutInitWindowPosition(80,40);

    glutCreateWindow(
        "Grand 3D Library Environment - Graphics Lab"
    );

    init();

    glutDisplayFunc(display);
    glutReshapeFunc(reshape);

    glutKeyboardFunc(keyDown);
    glutKeyboardUpFunc(keyUp);

    glutPassiveMotionFunc(mouseMove);

    glutTimerFunc(16,update,0);

    glutMainLoop();

    return 0;
}
