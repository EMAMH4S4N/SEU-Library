#include <GL/glut.h>
#include <cmath>
#include <cstdlib>
#include <windows.h>

float camX = 0.0f;
float camY = 1.75f;
float camZ = 7.0f;

float yaw = 180.0f;
float pitch = 0.0f;

bool keys[256] = {false};

int centerX = 600;
int centerY = 400;
bool warping = false;

float moveSpeed = 0.10f;

void setColor(float r,float g,float b)
{
    glColor3f(r,g,b);
}

void cube(float x,float y,float z,float sx,float sy,float sz)
{
    glPushMatrix();
    glTranslatef(x,y,z);
    glScalef(sx,sy,sz);
    glutSolidCube(1.0f);
    glPopMatrix();
}

void sphere(float x,float y,float z,float r)
{
    glPushMatrix();
    glTranslatef(x,y,z);
    glutSolidSphere(r,20,20);
    glPopMatrix();
}

void cylinder(float x,float y,float z,float r,float h)
{
    GLUquadric* q=gluNewQuadric();

    glPushMatrix();
    glTranslatef(x,y,z);
    glRotatef(-90,1,0,0);
    gluCylinder(q,r,r,h,24,2);
    gluDisk(q,0,r,24,1);
    glTranslatef(0,0,h);
    gluDisk(q,0,r,24,1);
    glPopMatrix();

    gluDeleteQuadric(q);
}

void floor()
{
    setColor(0.28f,0.15f,0.08f);
    cube(0,-0.15f,0,18.0f,0.3f,16.0f);

    setColor(0.40f,0.22f,0.10f);

    for(float x=-8.5f;x<=8.5f;x+=0.5f)
        cube(x,0.02f,0,0.035f,0.025f,15.5f);

    for(float z=-7.5f;z<=7.5f;z+=0.5f)
        cube(0,0.025f,z,17.5f,0.025f,0.035f);
}

