void bookshelf(float x,float y,float z,
               float w,float h,float d)
{
    float backZ  = z - d/2.0f + 0.04f;
    float frontZ = z + d/2.0f;

    // Thick wooden back panel - same style as the front frame
    texturedCube(x,y+h/2,backZ,w,h,0.18f,texWood,3.0f,3.0f);

    // Left and right wooden side panels
    texturedCube(x-w/2+0.10f,y+h/2,frontZ,
         0.20f,h+0.12f,d+0.10f,texWood,1.0f,3.0f);

    texturedCube(x+w/2-0.10f,y+h/2,frontZ,
         0.20f,h+0.12f,d+0.10f,texWood,1.0f,3.0f);

    // Top and bottom wooden frame
    texturedCube(x,y+h-0.08f,frontZ,
         w+0.12f,0.18f,d+0.10f,texWood,4.0f,1.0f);

    texturedCube(x,y+0.08f,frontZ,
         w+0.12f,0.18f,d+0.10f,texWood,4.0f,1.0f);

    // Six shelf levels.
    // The first shelf is deliberately low so books do not float upward.
    const int rows = 6;
    float usableH = h - 0.42f;
    float rowH = usableH / rows;

    for(int r=0;r<rows;r++)
    {
        float shelfY = y + 0.30f + r*rowH;

        // Wooden shelf board
        texturedCube(x,shelfY,frontZ,
             w-0.16f,0.13f,d+0.02f,texWood,4.0f,1.0f);

        // Books sit directly on this shelf.
        float px = x-w/2+0.18f;
        float bookBase = shelfY + 0.07f;

        for(int b=0;b<45 && px<x+w/2-0.16f;b++)
        {
            float bw = 0.13f + 0.025f*((b+r)%4);
            float bh = rowH*0.68f + 0.025f*((b+r)%3);

            if(px+bw > x+w/2-0.16f)
                bw = x+w/2-0.16f-px;

            if(bw <= 0.02f)
                break;

            book(px+bw/2,
                 bookBase+bh/2,
                 frontZ+0.09f,
                 bw,bh,d*0.58f,
                 (b*7+r*3)%12);

            px += bw+0.025f;
        }
    }

    // Thick bottom wooden plinth
    texturedCube(x,y-0.02f,frontZ,
         w+0.16f,0.28f,d+0.12f,texWood,4.0f,1.0f);
}


