void book(float x,float y,float z,
          float w,float h,float d,
          int c)
{
    float colors[12][3]=
    {
        {0.80f,0.05f,0.04f},
        {0.04f,0.20f,0.75f},
        {0.05f,0.55f,0.15f},
        {0.95f,0.70f,0.05f},
        {0.55f,0.08f,0.60f},
        {0.95f,0.30f,0.04f},
        {0.05f,0.55f,0.65f},
        {0.65f,0.35f,0.08f},
        {0.20f,0.20f,0.65f},
        {0.70f,0.05f,0.30f},
        {0.30f,0.60f,0.25f},
        {0.55f,0.55f,0.10f}
    };

    setColor(colors[c%12][0],
             colors[c%12][1],
             colors[c%12][2]);

    cube(x,y,z,w,h,d);
}

void bookshelf(float x,float y,float z,
               float w,float h,float d)
{
    setColor(0.45f,0.25f,0.10f);

    cube(x,y+h/2,z,w,0.16f,d);
    cube(x,y-h/2,z,w,0.16f,d);

    cube(x-w/2+0.08f,y,z,0.16f,h,d);
    cube(x+w/2-0.08f,y,z,0.16f,h,d);

    for(int i=1;i<4;i++)
        cube(x,
             y-h/2+i*(h/4.0f),
             z,
             w-0.12f,
             0.10f,
             d);

    for(int row=0;row<4;row++)
    {
        float shelfY=
            y-h/2+
            0.35f+
            row*(h/4.0f);

        float px=x-w/2+0.20f;

        for(int j=0;j<10;j++)
        {
            float bw=0.13f+(j%3)*0.025f;
            float bh=0.50f+(j%2)*0.10f;

            book(px+bw/2,
                 shelfY+bh/2,
                 z-0.04f,
                 bw,
                 bh,
                 d*0.78f,
                 j+row);

            px+=bw+0.055f;
        }
    }
}

