void table(float x,float y,float z)
{
    glColor3f(0.65f,0.42f,0.18f);

    cube(x,y,z,2.20f,0.16f,1.20f);

    cube(x-0.90f,y-0.72f,z-0.45f,
         0.12f,1.45f,0.12f);

    cube(x+0.90f,y-0.72f,z-0.45f,
         0.12f,1.45f,0.12f);

    cube(x-0.90f,y-0.72f,z+0.45f,
         0.12f,1.45f,0.12f);

    cube(x+0.90f,y-0.72f,z+0.45f,
         0.12f,1.45f,0.12f);

    glColor3f(0.92f,0.90f,0.82f);

    cube(x,y+0.15f,z,
         0.08f,0.28f,0.08f);

    glColor3f(0.95f,0.72f,0.20f);

    glutSolidSphere(0.13f,20,20);
}
