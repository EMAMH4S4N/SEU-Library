void bookshelf(float x,float y,float z)
{
    float w=3.5f;
    float h=4.0f;
    float d=0.70f;

    glColor3f(0.45f,0.25f,0.10f);

    cube(x,y+h/2,z,w,0.16f,d);
    cube(x,y-h/2,z,w,0.16f,d);

    cube(x-w/2+0.08f,y,z,
         0.16f,h,d);

    cube(x+w/2-0.08f,y,z,
         0.16f,h,d);

    for(int i=1;i<4;i++)
    {
        cube(x,
             y-h/2+i*(h/4.0f),
             z,
             w-0.12f,
             0.10f,
             d);
    }
}
