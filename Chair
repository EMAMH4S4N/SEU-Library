void chair(float x,float y,float z)
{
    glColor3f(0.45f,0.25f,0.10f);

    cube(x,y,z,
         0.70f,0.13f,0.65f);

    cube(x-0.25f,y-0.45f,z-0.22f,
         0.09f,0.90f,0.09f);

    cube(x+0.25f,y-0.45f,z-0.22f,
         0.09f,0.90f,0.09f);

    cube(x-0.25f,y-0.45f,z+0.22f,
         0.09f,0.90f,0.09f);

    cube(x+0.25f,y-0.45f,z+0.22f,
         0.09f,0.90f,0.09f);

    cube(x,y+0.42f,z+0.27f,
         0.70f,0.80f,0.10f);
}
